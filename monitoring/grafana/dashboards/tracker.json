    {
      "type": "stat",
      "title": "HTTP 5xx ratio",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(tracker_http_requests_total{code=~\"5..\",instance=~\"$instance\"}[5m])) or vector(0)) / clamp_min(sum(rate(tracker_http_requests_total{instance=~\"$instance\"}[5m])), 0.001)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
